{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "customManagers": [
   {
     "customType": "regex",
     "managerFilePatterns": [
     "/(^|/)Dockerfile$/"
    ],
     "matchStrings": [
       "# renovate: datasource=(?<datasource>.*?) depName=(?<depName>.*?)\\nARG RUNNER_VERSION=(?<currentValue>.*)"
     ],
     "versioningTemplate": "semver"
    }
  ]
}
